    {
      "type": "graph",
      "title": "Replication lag (bytes)",
      "targets": [
        { "expr": "pg_replication_lag_bytes{cluster=\"pg-ha-lab\"}" }
      ]
    },
    {
      "type": "stat",
      "title": "etcd healthy nodes",
      "targets": [
        { "expr": "count(up{job=\"patroni\"} == 1)" }
      ]
    }
  ],
